## Complete Example Script

Here's everything in one script you can run:

```python
# complete_training.py
from train_model import SpeedSignTrainer
import os

def main():
    print("=== Speed Sign Detector Training ===\n")
    
    # Step 1: Verify dataset exists
    if not os.path.exists('data/images/train'):
        print("ERROR: data/images/train not found!")
        print("Please create dataset first. See tutorial above.")
        return
    
    # Step 2: Create data.yaml if needed
    if not os.path.exists('data.yaml'):
        print("Creating data.yaml...")
        trainer = SpeedSignTrainer()
        trainer.create_data_yaml()
    
    # Step 3: Initialize trainer
    print("\nInitializing trainer...")
    trainer = SpeedSignTrainer(
        data_yaml='data.yaml',
        model_size='s',
        project_name='speed_detector_v1'
    )
    
    # Step 4: Train
    print("\nStarting training...")
    results = trainer.train(
        epochs=100,
        batch=16,
        imgsz=640,
        patience=20,
        augment=True
    )
    
    # Step 5: Validate
    print("\nValidating model...")
    metrics = trainer.validate()
    
    # Step 6: Export
    print("\nExporting model...")
    trainer.export_model(
        weights_path='runs/train/speed_detector_v1/weights/best.pt',
        formats=['onnx']
    )
    
    # Step 7: Report
    print("\nGenerating report...")
    trainer.create_training_report('runs/train/speed_detector_v1')
    
    print("\n✓ Training pipeline complete!")
    print(f"\nYour model: runs/train/speed_detector_v1/weights/best.pt")
    print(f"mAP50: {metrics.box.map50:.3f}")
    
    # Step 8: Test on image
    if os.path.exists('test_images/sample.jpg'):
        print("\nTesting on sample image...")
        trainer.test_inference(
            test_image='test_images/sample.jpg',
            weights_path='runs/train/speed_detector_v1/weights/best.pt'
        )
        print("Result saved!")

if __name__ == "__main__":
    main()
```

Run everything at once:
```bash
python complete_training.py
```

